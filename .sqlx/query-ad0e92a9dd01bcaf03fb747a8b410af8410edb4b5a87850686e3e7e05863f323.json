  "query": "\n\t\t\t\tUPDATE download_history\n\t\t\t\tSET\n\t\t\t\t\tstatus = COALESCE(?, status),\n\t\t\t\t\tupdated_at = CASE WHEN ? IS NOT NULL THEN CURRENT_TIMESTAMP ELSE updated_at END\n\t\t\t\tWHERE gid = ?\n\t\t\t\tRETURNING\n\t\t\t\t\tgid,\n\t\t\t\t\tname,\n\t\t\t\t\tkind as \"kind: Kind\",\n\t\t\t\t\tstatus as \"status: GidStatus\",\n\t\t\t\t\tdir,\n\t\t\t\t\tfiles,\n\t\t\t\t\ttotal_length,\n\t\t\t\t\tcompleted_length,\n\t\t\t\t\tupload_length,\n\t\t\t\t\tsource_uri,\n\t\t\t\t\tinfo_hash,\n\t\t\t\t\tseeder,\n\t\t\t\t\tcontent_hash,\n\t\t\t\t\terror_code,\n\t\t\t\t\terror_message,\n\t\t\t\t\ttorrent as \"torrent: sqlx::types::Json<TorrentMagnetMeta>\",\n\t\t\t\t\toptions,\n\t\t\t\t\tis_resume_supported,\n\t\t\t\t\tconnections,\n\t\t\t\t\tnum_pieces,\n\t\t\t\t\tnum_seeders,\n\t\t\t\t\tpiece_length,\n\t\t\t\t\tverified_length,\n\t\t\t\t\tverify_integrity_pending,\n\t\t\t\t\tcreated_at,\n\t\t\t\t\tcompleted_at,\n\t\t\t\t\tuser_id\n            ",
